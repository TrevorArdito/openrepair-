# Copy to .env and adjust. NEVER commit .env.
# Values below are safe defaults for local development only.

# --- App ---
APP_ENV=development
# Generate a long random value for production: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-dev-only
PUBLIC_BASE_URL=http://localhost:5173
SOURCE_CODE_URL=https://github.com/TrevorArdito/openrepair-

# --- Database ---
# Postgres (Docker): postgresql+psycopg://chrystalclear:chrystalclear@db:5432/chrystalclear
# SQLite (no Docker): sqlite:///./chrystalclear.db
DATABASE_URL=sqlite:///./chrystalclear.db

# --- Email (dev prints emails to the console) ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.org
# Turn on once email sending works: new accounts must confirm their email before contributing.
REQUIRE_VERIFIED_EMAIL=false

# --- Accounts ---
# Emails that become admins when they sign up / log in (comma separated).
ADMIN_EMAILS=

# --- Google Search Console verification (optional) ---
GOOGLE_SITE_VERIFICATION=

# --- Photo storage ---
# local = disk (dev); database = inside Postgres (free hosts that wipe their disk)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- External data ---
NHTSA_VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
NHTSA_API_BASE_URL=https://api.nhtsa.gov

# --- Anti-spam (optional) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Feature modules ---
# Hardware (OBD-II / J2534) is OFF by default and writes to vehicles always require confirmation.
ENABLE_HARDWARE=false
# Parts marketplace (new + used parts with fitment, messages, moderation). OFF by default.
ENABLE_MARKETPLACE=false
# Marketplace payments (Stripe Connect) — see docs/PAYMENTS.md. Keys are SECRETS: env only.
ENABLE_MARKET_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MARKET_FEE_PERCENT=6
MARKET_STRIPE_FEE_PERCENT=2.9
MARKET_STRIPE_FEE_FIXED_CENTS=30
MARKET_TAX_ENABLED=false
MARKET_RELEASE_DAYS_AFTER_DELIVERY=3
MARKET_RELEASE_DAYS_AFTER_SHIP=30
MARKET_CONTACT_ONLY_CATEGORIES=vehicle
MARKET_INFORM_SALES=200
MARKET_INFORM_REVENUE_CENTS=500000
